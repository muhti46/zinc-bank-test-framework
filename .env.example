# ZincBank test framework environment template.
# Copy this file to `.env` and fill in your own values. NEVER commit real credentials.

# Base URL of the ZincBank login page
BASE_URL=https://zincbank.cydeo.io/login

# Valid user for the "log in with valid credentials" steps (US00-AC2 / US01-AC1)
APP_USERNAME=your-email@zinc.test
APP_PASSWORD=your-password

# Invalid user for the "log in with invalid credentials" step (US00-AC3)
APP_INVALID_USERNAME=invalid@zinc.test
APP_INVALID_PASSWORD=wrong-password

# Exact error text shown for invalid credentials (US00-AC3)
EXPECTED_ERROR_TEXT=Invalid email or password.

# Run the browser in headed mode when false (true = headless, default)
HEADLESS=true
