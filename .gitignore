# Dependencies
node_modules/

# Environment variables - never commit secrets
.env
.env.local
.env.*.local

# TypeScript build output
dist/

# Cucumber reports and screenshots (keep the folders, ignore their content)
reports/*
!reports/.gitkeep
test-results/*
!test-results/screenshots/
test-results/screenshots/*
!test-results/screenshots/.gitkeep

# Allure report data (keep the raw-results folder, ignore its content)
allure-results/*
!allure-results/.gitkeep
allure-report/

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# Temporary exploration/probe scripts (developer work-in-progress)
.scratch/
